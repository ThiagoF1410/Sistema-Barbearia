NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:5173

# Neon: use uma URL terminando em sslmode=verify-full.
DATABASE_URL=
JWT_SECRET=
JWT_EXPIRES_IN=7d

EMAIL_USER=
EMAIL_PASS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Use sk_test_ durante desenvolvimento e homologação.
STRIPE_MODE=test
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=

# Integração experimental pelo WhatsApp Web com Baileys.
WHATSAPP_ENABLED=false
WHATSAPP_TIMEOUT_MS=10000
WHATSAPP_RECONNECT_MS=5000
WHATSAPP_NOTIFICATION_INTERVAL_MS=30000

# Endpoint administrativo usado somente para validar o envio.
WHATSAPP_TEST_ENDPOINT_ENABLED=false
WHATSAPP_TEST_RECIPIENT=
WHATSAPP_TEST_MESSAGE=Teste de confirmação de agendamento — O Rei da Navalha.
