NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:5173
# Habilite somente para testar o frontend em outro dispositivo da rede local.
CORS_ALLOW_PRIVATE_NETWORK=false

# Banco de dados. No Neon, use uma URL terminando em sslmode=verify-full.
DATABASE_URL=
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=10000

# Alternativa à DATABASE_URL para PostgreSQL local.
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSL=false

# Gere um valor aleatório com pelo menos 32 caracteres.
JWT_SECRET=
# Token curto mantido apenas na memória do navegador.
JWT_ACCESS_EXPIRES_IN=15m

# Conta SMTP usada na recuperação de senha.
EMAIL_USER=
EMAIL_PASS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Use sk_test_ em desenvolvimento/homologação e sk_live_ em produção.
STRIPE_MODE=test
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=

# Integração pelo WhatsApp Web com Baileys.
WHATSAPP_ENABLED=false
WHATSAPP_REMINDERS_ENABLED=false
WHATSAPP_TIMEOUT_MS=10000
WHATSAPP_RECONNECT_MS=5000
WHATSAPP_NOTIFICATION_INTERVAL_MS=30000
WHATSAPP_SESSION_DIR=./.whatsapp-session

# Número público da barbearia no formato 55 + DDD + número, somente dígitos.
WHATSAPP_CONTACT_NUMBER=

# Endpoint administrativo opcional, habilitado somente durante testes controlados.
WHATSAPP_TEST_ENDPOINT_ENABLED=false
WHATSAPP_TEST_RECIPIENT=
WHATSAPP_TEST_MESSAGE=Teste de confirmação de agendamento — O Rei da Navalha.
